# Opção 1: cole uma URL PostgreSQL completa; ela tem precedência sobre os campos.
# Codifique caracteres especiais da senha como componentes de URL.
DATABASE_URL=
# Opção 2: deixe DATABASE_URL vazia e preencha os campos do Session pooler.
# DATABASE_PASSWORD recebe a senha original, sem codificação de URL.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=
DATABASE_PASSWORD=
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000

# SDK oficial: copie os valores completos do painel Connect > Flask.
# A conexão PostgreSQL acima continua sendo usada por SQLAlchemy/Migrate.
# Ambos vazios deixam o SDK desativado, sem impedir o uso do banco.
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_PUBLISHABLE_KEY também é aceito e tem precedência sobre SUPABASE_KEY.
